<title>Wiring &amp; Test Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#EEF1F0;
  --surface:#FFFFFF;
  --ink:#1B1E20;
  --ink-mute:#5B6266;
  --line:#C9CED0;
  --orange:#C24E19;
  --blue:#2C6E8E;
  --orange-tint:#F3E3D8;
  --blue-tint:#DEEAEF;
  --green:#3C7A4B;
  --green-tint:#DEEEE1;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#14171A;
    --surface:#1D2124;
    --ink:#ECEEEF;
    --ink-mute:#9AA3A8;
    --line:#33393D;
    --orange:#FF8A4C;
    --blue:#5FB4D8;
    --orange-tint:#3A2416;
    --blue-tint:#122A33;
    --green:#6FCB85;
    --green-tint:#173222;
  }
}
:root[data-theme="dark"]{
  --paper:#14171A;
  --surface:#1D2124;
  --ink:#ECEEEF;
  --ink-mute:#9AA3A8;
  --line:#33393D;
  --orange:#FF8A4C;
  --blue:#5FB4D8;
  --orange-tint:#3A2416;
  --blue-tint:#122A33;
  --green:#6FCB85;
  --green-tint:#173222;
}

*{box-sizing:border-box;}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing:antialiased;
}

.sheet{
  max-width:920px;
  margin:0 auto;
  padding:2.75rem 1.5rem 5rem;
}

/* ---------- Masthead ---------- */
.masthead{
  border:2px solid var(--ink);
  padding:1.5rem 1.5rem 1.25rem;
  margin-bottom:2.5rem;
  position:relative;
}
.masthead::before{
  content:"";
  position:absolute;
  top:6px; left:6px; right:6px; bottom:6px;
  border:1px solid var(--line);
  pointer-events:none;
}
.masthead .kicker{
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.72rem;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--ink-mute);
  display:flex;
  justify-content:space-between;
  margin-bottom:0.9rem;
}
.masthead h1{
  font-family:"Big Shoulders Stencil", "Arial Narrow", sans-serif;
  font-weight:700;
  font-size:clamp(2.1rem, 6vw, 2.9rem);
  line-height:1;
  letter-spacing:0.01em;
  margin:0 0 0.5rem;
  text-wrap:balance;
}
.masthead .sub{
  font-size:0.95rem;
  color:var(--ink-mute);
  max-width:74ch;
  line-height:1.5;
}
.masthead .fields{
  margin-top:1.25rem;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0.75rem 2rem;
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.78rem;
}
.field-line{
  display:flex;
  align-items:baseline;
  gap:0.5rem;
  color:var(--ink-mute);
}
.field-line .blank{
  flex:1;
  border-bottom:1px solid var(--ink-mute);
  height:1.1em;
}

/* ---------- Legend ---------- */
.legend{
  display:flex;
  flex-wrap:wrap;
  gap:0.5rem 1.5rem;
  margin-bottom:2.25rem;
  font-size:0.8rem;
  color:var(--ink-mute);
}
.legend span{display:flex; align-items:center; gap:0.45rem;}
.swatch{
  width:0.85em; height:0.85em;
  border:1.5px solid currentColor;
  border-radius:2px;
  flex:none;
}
.swatch.wired{color:var(--green); background:var(--green-tint);}
.swatch.draft{color:var(--orange); background:var(--orange-tint);}
.swatch.gap{color:var(--blue); background:var(--blue-tint);}

/* ---------- Sections ---------- */
.section{margin-bottom:2.5rem;}
.section-head{
  display:flex;
  align-items:baseline;
  gap:0.9rem;
  border-bottom:2px solid var(--ink);
  padding-bottom:0.5rem;
  margin-bottom:0.9rem;
}
.section-num{
  font-family:"Big Shoulders Stencil", "Arial Narrow", sans-serif;
  font-size:1.6rem;
  color:var(--ink-mute);
  line-height:1;
}
.section-head h2{
  font-family:"Big Shoulders Stencil", "Arial Narrow", sans-serif;
  font-weight:600;
  font-size:1.35rem;
  letter-spacing:0.02em;
  text-transform:uppercase;
  margin:0;
  line-height:1;
}
.section-note{
  font-size:0.85rem;
  color:var(--ink-mute);
  margin:0 0 1rem;
  line-height:1.55;
  max-width:74ch;
}
.section.flippers .section-head, .section.draft .section-head{border-color:var(--orange);}
.section.flippers .section-num, .section.draft .section-num{color:var(--orange);}
.section.decision .section-head{border-color:var(--blue);}
.section.decision .section-num{color:var(--blue);}

.divider{
  display:flex;
  align-items:center;
  gap:0.9rem;
  margin:3rem 0 2rem;
  font-family:"Big Shoulders Stencil", "Arial Narrow", sans-serif;
  font-size:1.1rem;
  letter-spacing:0.03em;
  text-transform:uppercase;
  color:var(--ink-mute);
}
.divider::before, .divider::after{
  content:"";
  flex:1;
  border-top:2px dashed var(--line);
}

/* ---------- Tables ---------- */
.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:6px;
  overflow-x:auto;
}
table.wtable{
  width:100%;
  border-collapse:collapse;
  font-size:0.82rem;
}
table.wtable th, table.wtable td{
  padding:0.45rem 0.7rem;
  border-bottom:1px solid var(--line);
  text-align:left;
  white-space:nowrap;
}
table.wtable thead th{
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.68rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--ink-mute);
  font-weight:500;
}
table.wtable tbody tr:last-child td{border-bottom:none;}
table.wtable td.num, table.wtable td.brd{font-family:"IBM Plex Mono", ui-monospace, monospace;}
.status{
  display:inline-block;
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.66rem;
  letter-spacing:0.05em;
  text-transform:uppercase;
  padding:0.08rem 0.4rem;
  border-radius:3px;
}
.status.wired{color:var(--green); background:var(--green-tint);}
.status.planned{color:var(--orange); background:var(--orange-tint);}
.status.gap{color:var(--blue); background:var(--blue-tint);}

.grid-two{display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;}
@media (max-width:640px){
  .grid-two{grid-template-columns:1fr;}
  table.wtable{font-size:0.76rem;}
  .masthead .fields{grid-template-columns:1fr;}
}

.sketch{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:6px;
  padding:1rem;
}
.sketch h3{
  margin:0 0 0.6rem;
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.72rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--ink-mute);
  font-weight:500;
}
.sketch svg{width:100%; height:auto; display:block;}
.sketch .caption{
  margin-top:0.6rem;
  font-size:0.78rem;
  color:var(--ink-mute);
  line-height:1.5;
}

.callout{
  border:1px solid var(--line);
  border-left:4px solid var(--orange);
  background:var(--orange-tint);
  border-radius:0 6px 6px 0;
  padding:0.8rem 1rem;
  font-size:0.85rem;
  line-height:1.55;
  margin-top:1rem;
}
.callout b{font-weight:600;}

/* ---------- Checklist items (bench-test sections) ---------- */
.item{
  display:flex;
  align-items:flex-start;
  gap:0.75rem;
  padding:0.6rem 0.9rem;
  border-top:1px solid var(--line);
}
.item:first-child{border-top:none;}
.box{
  flex:none;
  width:1rem; height:1rem;
  margin-top:0.2rem;
  border:1.5px solid var(--ink);
  border-radius:2px;
}
.item-body{flex:1; min-width:0;}
.item-label{
  font-size:0.92rem;
  line-height:1.4;
}
.item-label b{font-weight:600;}
.item-meta{
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.74rem;
  color:var(--ink-mute);
  letter-spacing:0.02em;
}
.item-note{
  display:flex;
  align-items:baseline;
  gap:0.4rem;
  margin-top:0.35rem;
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.72rem;
  color:var(--ink-mute);
}
.item-note .blank{
  flex:1;
  min-width:3rem;
  max-width:14rem;
  border-bottom:1px solid var(--line);
  height:1.1em;
}
.tag{
  display:inline-block;
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.65rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  padding:0.1rem 0.4rem;
  border-radius:3px;
  margin-left:0.4rem;
  vertical-align:1px;
}
.tag.draft{color:var(--orange); background:var(--orange-tint);}
.tag.decision{color:var(--blue); background:var(--blue-tint);}

.subhead{
  font-family:"IBM Plex Mono", ui-monospace, monospace;
  font-size:0.7rem;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:var(--ink-mute);
  margin:1.1rem 0 0.4rem;
}
.subhead:first-child{margin-top:0;}

footer{
  margin-top:2.5rem;
  padding-top:1rem;
  border-top:1px solid var(--line);
  font-size:0.75rem;
  color:var(--ink-mute);
  line-height:1.6;
}

@media print{
  body{background:#fff; color:#000;}
  .sheet{max-width:none; padding:0.4in;}
  .card, .sketch{box-shadow:none;}
  .section{break-inside:avoid; page-break-inside:avoid;}
  a{color:inherit; text-decoration:none;}
}
</style>

<div class="sheet">

  <div class="masthead">
    <div class="kicker">
      <span>Portal Pinball V4.0 — Wiring &amp; Field Test</span>
      <span>OPP gen2 · COM4/5/6</span>
    </div>
    <h1>Wiring &amp; Test Guide</h1>
    <div class="sub">Board map, known-component wiring tables, and connector diagrams to support wiring the cabinet by hand — followed by the bench-test procedure to run once something here is wired. Source of truth for live status stays <span style="font-family:'IBM Plex Mono',monospace">tools/hw_console/data/components.yaml</span>; this page is generated from that data plus <span style="font-family:'IBM Plex Mono',monospace">machinefolder/config/hardware-*.yaml</span> by <span style="font-family:'IBM Plex Mono',monospace">tools/hw_console/generate_docs.py</span> — do not hand-edit this file, it will be overwritten.</div>
    <div class="fields">
      <div class="field-line">Date <span class="blank">{{ generated_at }}</span></div>
      <div class="field-line">MPF version <span class="blank"></span></div>
      <div class="field-line">Run by <span class="blank"></span></div>
      <div class="field-line">Build/commit <span class="blank"></span></div>
    </div>
  </div>

  <div class="legend">
    <span><span class="swatch wired"></span>Wired / standard — real, confirmed on the cabinet</span>
    <span><span class="swatch draft"></span>Draft / planned — DRAFT config, not wired for real yet</span>
    <span><span class="swatch gap"></span>Gap / decision — hardware or config missing, or a measurement to record</span>
  </div>

  <!-- 01 -->
  <div class="section">
    <div class="section-head"><span class="section-num">01</span><h2>Board map</h2></div>
    <p class="section-note">Six physical CPU boards across three USB-serial chains. The two Cobra boards share one physical PCB (two STM32 modules) but count as independent CPUs/chains for wiring purposes — a hardware autofire rule cannot cross between them, or onto the PSOC chain. <b>This machine is being rewired from scratch, board assignment follows a fixed priority: CobraPin first (chain 0, then chain 1), the red PSOC boards (chain 2) only as a fallback when CobraPin can't fit something, and every LED goes on CobraPin, no exceptions.</b> See <span style="font-family:'IBM Plex Mono',monospace">docs/opp-hardware-reference.md</span> for the full rulebook this page is built from. Counts below are real, derived from <span style="font-family:'IBM Plex Mono',monospace">hardware-switches.yaml</span>/<span style="font-family:'IBM Plex Mono',monospace">-coils.yaml</span>/<span style="font-family:'IBM Plex Mono',monospace">-leds.yaml</span> — remaining free capacity per board isn't tracked as structured data anywhere in this repo, so it isn't shown here (see <span style="font-family:'IBM Plex Mono',monospace">board Overviews.xlsx</span> or physical inspection for that).</p>
    <div class="card">
      <table class="wtable">
        <thead><tr><th>Board</th><th>Port</th><th>Role</th><th>Switches in use</th><th>Coils in use</th><th>Reserved</th><th>LEDs in use</th></tr></thead>
        <tbody>
{%- for board in boards %}
          <tr><td>{{ board.display_name }}</td><td class="brd">{{ board.port }}</td><td>{{ board.role }}</td><td class="num">{{ board.switches_used }}</td><td class="num">{{ board.coils_used }}</td><td class="num">{{ board.reserved }}</td><td class="num">{{ board.leds_used }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 02 -->
  <div class="section">
    <div class="section-head"><span class="section-num">02</span><h2>CobraPin banks &amp; HV power reference</h2></div>
    <p class="section-note">The 3 solenoid banks (A/B/C, 8 outputs each) each have their own fused HV supply pin (<span style="font-family:'IBM Plex Mono',monospace">HV_A</span>/<span style="font-family:'IBM Plex Mono',monospace">HV_B</span>/<span style="font-family:'IBM Plex Mono',monospace">HV_C</span> on connector J13) — <b>a coil's +50V lead must come from the HV pin matching its own bank</b>, never a generic shared bus. Full detail and sources in <span style="font-family:'IBM Plex Mono',monospace">docs/opp-hardware-reference.md</span>.</p>
    <div class="card" style="margin-bottom:1.25rem;">
      <table class="wtable">
        <thead><tr><th>Bank</th><th>Chain 0/1 pins</th><th>HV feed</th><th>Wire color</th></tr></thead>
        <tbody>
          <tr><td><b>A</b></td><td class="num">0-0-0, 0-0-8…0-0-14</td><td class="num">HV_A</td><td>brown — includes flipper coils <b>0-0-8</b>/<b>0-0-9</b>, slings <b>0-0-0</b>/<b>0-0-12</b>, ball saver <b>0-0-13</b></td></tr>
          <tr><td><b>B</b></td><td class="num">0-0-1…0-0-7, 0-0-15</td><td class="num">HV_B</td><td>teal</td></tr>
          <tr><td><b>C</b></td><td class="num">1-0-0…1-0-7</td><td class="num">HV_C</td><td>purple</td></tr>
        </tbody>
      </table>
    </div>
    <div class="callout">
      <b>Mixing up bank power and bank driver can blow FETs, coils, and fuses</b> (CobraPin's own doc wording). Test without coil power first, and check the per-bank yellow coil LED to confirm a bank actually has power before trusting it. A bank's connector pins can also be pre-broken-out to a wall-mounted terminal block without any coil actually being wired to them yet — wires present on a bank's connector doesn't by itself mean it's in use, check the far end of the run. <code>tools/wiring_test.py</code> automates the switch-continuity + coil-LED half of this check (see the repo README) — used first for the flippers, 2026-09-06.
    </div>
  </div>

  <!-- 03 -->
  <div class="section">
    <div class="section-head"><span class="section-num">03</span><h2>Red boards — classic/modular OPP (chain 2)</h2></div>
    <p class="section-note">Chain 2's 4 PSOC boards follow a <b>different, tighter</b> rule than CobraPin — used here only as the fallback when CobraPin can't fit a component (per section 01's priority). Full detail in <span style="font-family:'IBM Plex Mono',monospace">docs/opp-hardware-reference.md</span>.</p>
    <div class="card">
      <div class="item"><span class="box" style="visibility:hidden"></span><div class="item-body"><div class="item-label">Up to 4 plug-in "wings" per board (solenoid/switch/lamp, mixed freely) — not one combo PCB like CobraPin. <b>5V</b> switch logic, vs. CobraPin's 3.3V.</div></div></div>
      <div class="item"><span class="box" style="visibility:hidden"></span><div class="item-body"><div class="item-label">Numbering is wing-position-based: switches = wing×8 (<span class="item-meta">0-7, 8-15, 16-23, 24-31</span>), coils = wing×4 (<span class="item-meta">0-3, 4-7, 8-11, 12-15</span>).</div></div></div>
      <div class="item"><span class="box" style="visibility:hidden"></span><div class="item-body"><div class="item-label"><b>Pairing rule:</b> a solenoid wing's own dedicated switch inputs are the first four switch numbers of that same wing — a coil in wing N (<span class="item-meta">4N..4N+3</span>) pairs only with a switch in <span class="item-meta">8N..8N+3</span>, not just "anywhere on the same board." Confirmed against this cabinet's own working hardware: <span class="item-meta">c-sling-right/left</span> (<span class="item-meta">2-0-0/1</span>, since moved to the Cobra board — see section 04's table) paired with switches <span class="item-meta">2-0-0/1</span>; <span class="item-meta">c-popbumper-1/2/3</span> (<span class="item-meta">2-0-4/5/6</span>) pair with switches <span class="item-meta">2-0-8/9/10</span> — the first 3 of wing 1's 4 dedicated slots.</div></div></div>
    </div>
  </div>

  <!-- 04 -->
  <div class="section">
    <div class="section-head"><span class="section-num">04</span><h2>Known components — current wiring</h2></div>
    <p class="section-note">Generated from <span style="font-family:'IBM Plex Mono',monospace">tools/hw_console/data/components.yaml</span> — update that file first (or the hw_console web UI) if anything changes, then re-run the generator, never edit this table by hand.</p>
    <div class="card">
      <table class="wtable">
        <thead><tr><th>Component</th><th>Switches</th><th>Coils</th><th>Board</th><th>Status</th></tr></thead>
        <tbody>
{%- for c in components %}
          <tr><td>{{ c.display_name }}</td><td class="num">{{ c.switches_str }}</td><td class="num">{{ c.coils_str }}</td><td class="brd">{{ c.boards | join(', ') }}</td><td><span class="status {{ c.badge }}">{{ c.badge }}</span></td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 05 -->
  <div class="section flippers">
    <div class="section-head"><span class="section-num">05</span><h2>Flippers — new wiring via the Cobra board</h2></div>
    <p class="section-note">Decision: route the flipper switch + coil through Cobra chain 0 (<span style="font-family:'IBM Plex Mono',monospace">chain0-0x20</span>, port COM4) instead of the PSOC chain. CobraPin's own documentation says timing-critical devices (flippers, slings, pop bumpers) should have their switch and coil on the <b>same physical STM32 board</b>, so the hardware autofire rule runs with minimal latency and doesn't need to cross a board boundary. Chain 0 has plenty of free capacity and already anchors most of the game's LEDs, so it's the natural home. Coil numbers (<b>0-0-8</b>/<b>0-0-9</b>) and switch numbers (<b>0-0-1</b>/<b>0-0-2</b>) are both the actual pins used for real physical wiring (2026-09-06, confirmed while wiring); bank/HV feed from section 02's reference table.</p>

    <div class="card" style="margin-bottom:1.25rem;">
      <table class="wtable">
        <thead><tr><th>Device</th><th>Old (PSOC, unused)</th><th>New (Cobra chain 0)</th><th>Connector</th></tr></thead>
        <tbody>
          <tr><td>c-flipper-left</td><td class="num" style="text-decoration:line-through;color:var(--ink-mute)">2-1-0</td><td class="num"><b>0-0-8</b> <span class="item-meta">(Bank A, HV_A brown)</span></td><td>Coil bank (pins 0-0-8/9/10/11)</td></tr>
          <tr><td>c-flipper-right</td><td class="num" style="text-decoration:line-through;color:var(--ink-mute)">2-1-1</td><td class="num"><b>0-0-9</b> <span class="item-meta">(Bank A, HV_A brown)</span></td><td>same bank, adjacent pin</td></tr>
          <tr><td>s-left-flipper</td><td class="num" style="text-decoration:line-through;color:var(--ink-mute)">2-1-0</td><td class="num"><b>0-0-1</b></td><td>Switch input header, chain 0</td></tr>
          <tr><td>s-right-flipper</td><td class="num" style="text-decoration:line-through;color:var(--ink-mute)">2-1-1</td><td class="num"><b>0-0-2</b></td><td>same header, adjacent pin</td></tr>
        </tbody>
      </table>
    </div>

    <div class="grid-two">
      <div class="sketch">
        <h3>Coil bank A — generated from tools/hw_console/data/harnesses/flipper-bank-a.yaml</h3>
{%- if harness_svgs.get('flipper-bank-a') %}
        {{ harness_svgs['flipper-bank-a'] | safe }}
        <div class="caption">Generated by WireViz from <span style="font-family:'IBM Plex Mono',monospace">tools/hw_console/data/harnesses/flipper-bank-a.yaml</span> — sourced from <span style="font-family:'IBM Plex Mono',monospace">docs/opp-hardware-reference.md</span>'s per-pin bank/HV-feed/color table and this cabinet's own confirmed wiring (2026-09-06). The flyback diode across each coil isn't shown in this cable diagram (WireViz models routing, not discrete parallel components) — cathode toward HV_A, anode toward the driver pin; see the callout below.</div>
{%- else %}
        <div class="caption" style="color:var(--orange)">WireViz diagram not available in this build — install the <span style="font-family:'IBM Plex Mono',monospace">wireviz</span> Python package and the Graphviz <span style="font-family:'IBM Plex Mono',monospace">dot</span> binary (see README), then re-run <span style="font-family:'IBM Plex Mono',monospace">generate_docs.py</span>.</div>
{%- endif %}
      </div>

      <div class="sketch">
        <h3>Switch wing — connector pins + which lug goes where</h3>
        <svg viewBox="0 0 260 250" xmlns="http://www.w3.org/2000/svg">
          <text x="130" y="14" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9" fill="var(--ink-mute)" letter-spacing="0.05em">CHAIN0-0x20 · SWITCH WING (J-x)</text>
